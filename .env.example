# =============================================================================
# Customer Support System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── LLM ───────────────────────────────────────────────────────────────────────
# Primary LLM: Google Gemini (recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback LLM: Groq (optional — used if GEMINI_API_KEY is not set)
GROQ_API_KEY=your_groq_api_key_here

# ── PostgreSQL (Local / VPS) ──────────────────────────────────────────────────
# Format: postgresql://user:password@host:5432/dbname
# Used for: Application DB (tickets, orders, approvals) + LangGraph checkpoints
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/customer_support

# ── Redis — Upstash ───────────────────────────────────────────────────────────
# Format: rediss://default:<token>@<host>.upstash.io:6379
# Note: rediss:// (double-s) = TLS — required for Upstash
# Used for: Celery result backend + LLM response cache
REDIS_URL=rediss://default:your_upstash_token@your-endpoint.upstash.io:6379

# ── RabbitMQ — CloudAMQP (Free Tier: "Little Lemur") ─────────────────────────
# Sign up: https://www.cloudamqp.com/ — free plan gives 1M messages/month
# Format: amqps://user:password@host/vhost
# Used for: Celery task broker (async agent execution)
# If not set, Redis will be used as broker instead (simpler for local dev)
RABBITMQ_URL=amqps://your_user:your_password@your-host.cloudamqp.com/your_vhost

# ── LangSmith Observability (Optional but Recommended) ───────────────────────
# Sign up: https://smith.langchain.com/
# When enabled, every LLM call, tool invocation, and token count is auto-traced
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=customer-support-agents
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── App Settings ──────────────────────────────────────────────────────────────
APP_VERSION=2.0.0
DEBUG=false